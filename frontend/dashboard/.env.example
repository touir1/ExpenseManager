# Environment configuration for development

# Backend API base URL (must start with http/https). Talking directly to the users
# service like this is fine when both run over plain HTTP (same scheme = same-site
# cookies). If you're instead running against the nginx-fronted stack (https://localhost),
# leave this empty and set VITE_API_PROXY_TARGET below — otherwise the auth cookie gets
# stripped on cross-scheme requests and login silently fails with MISSING_TOKEN.
VITE_API_BASE="http://localhost:9100"

# Uncomment when developing against the nginx-fronted stack instead of a bare backend
# service — proxies /api same-origin through the dev server so cookies stay same-site.
# VITE_API_BASE=""
# VITE_API_PROXY_TARGET="https://localhost"

# Port for Vite dev server
VITE_PORT=5173
 
# Application code used by backend to associate registrations
VITE_APPLICATION_CODE="EXPENSES_MANAGER"
